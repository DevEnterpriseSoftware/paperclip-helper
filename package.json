{
  "name": "paperclip-helper",
  "version": "1.12.1",
  "description": "Runs beside a self-hosted Paperclip and fixes what it doesn't recover from by itself: approve agents' work by merging their PRs, restart stalled work, pause agents at a usage limit, and record what subscription runs really cost.",
  "keywords": [
    "paperclip",
    "ai-agents",
    "claude-code",
    "codex",
    "github-webhooks",
    "watchdog",
    "cost-tracking"
  ],
  "license": "MIT",
  "author": "DevEnterprise Software",
  "homepage": "https://github.com/DevEnterpriseSoftware/paperclip-helper#readme",
  "bugs": {
    "url": "https://github.com/DevEnterpriseSoftware/paperclip-helper/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "paperclip-helper": "src/index.mjs"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node --test --test-reporter=spec \"test/*.test.mjs\"",
    "test:compat": "node test/compat/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DevEnterpriseSoftware/paperclip-helper.git"
  }
}
