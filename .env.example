# Paperclip Helper settings. For a manual install, copy this file to .env and
# chmod 600 it; the installer writes its own .env.
# Every setting is optional unless marked required. Docs:
# https://github.com/DevEnterpriseSoftware/paperclip-helper

# ---- Docker (read by compose.yml)

# The user and group that own ./data (`id -u`, `id -g`). Default 1000:1000.
PCH_UID=1000
PCH_GID=1000
# Another image or tag, e.g. a pinned version: ghcr.io/deventerprisesoftware/paperclip-helper:1.0.0
#PCH_IMAGE=

# ---- Paperclip

# Paperclip's API as seen from inside the helper container. With host
# networking that's the port Paperclip listens on or publishes on the host.
# Any hostname other than localhost/127.0.0.1 must be allowed in Paperclip:
# `npx paperclipai allowed-hostname <host>`.
PAPERCLIP_API=http://127.0.0.1:3100

# The address you open Paperclip at in a browser. Used only for the approval
# link `pch login` prints.
PAPERCLIP_PUBLIC_URL=

# Lifetime of the board API key `pch login` creates, in days (0 = never expires).
KEY_EXPIRES_DAYS=365

# true = every component logs what it would do and changes nothing.
DRY_RUN=false

# debug, info, warn or error.
LOG_LEVEL=info

# ---- Relay: GitHub webhooks → your approval decisions
#
# Turns on by itself when any of the three GitHub settings below is set, and then
# needs all three. RELAY=false keeps it off regardless; RELAY=true refuses to
# start without them.

#RELAY=

# Required for the relay. The shared secret you also give the GitHub webhook.
# Generate one with `openssl rand -hex 32` (or `pch secret`).
GITHUB_WEBHOOK_SECRET=

# Required for the relay. Your GitHub login: only your merges, reviews and
# comments approve or request changes.
GITHUB_OWNER_LOGIN=

# Required for the relay. Comma-separated owner/repo list the relay accepts.
GITHUB_REPOS=

# Issue prefixes to look for in a PR's title, branch or body, comma-separated.
# Empty = every prefix of the companies your key can see (read from Paperclip).
ISSUE_PREFIXES=

# Post each newly opened (or reopened, or ready-for-review) PR's URL on its issue,
# so Paperclip links it: its "GitHub Pull Request" rows only pick up full
# github.com URLs in the issue's text.
RELAY_LINK_PRS=true

# Send PRs with merge conflicts back to their agents. After every merge (and
# every RELAY_CONFLICT_SWEEP_SEC) the relay looks at the other open PRs, and for
# each one GitHub says conflicts with its base branch it requests changes on the
# PR's issue (or comments, when its review isn't waiting on you) and says so on
# the PR. Needs GITHUB_TOKEN.
RELAY_FIX_CONFLICTS=false

# A GitHub token for the above. Fine-grained: access to the GITHUB_REPOS
# repositories only, with "Pull requests: Read and write" (Read-only if
# RELAY_CONFLICT_PR_COMMENT=false). Classic: the "repo" scope. Steps:
# https://github.com/DevEnterpriseSoftware/paperclip-helper/blob/main/docs/relay.md#the-github-token
GITHUB_TOKEN=

# Send-backs per PR while it keeps conflicting, one per push, before it is left to you.
#RELAY_CONFLICT_MAX_ATTEMPTS=2
# Say on the PR that it was sent back.
#RELAY_CONFLICT_PR_COMMENT=true
# Also look at every open PR this often, in seconds. 0 = only after a merge.
#RELAY_CONFLICT_SWEEP_SEC=900
# GitHub Enterprise Server: https://<host>/api/v3
#GITHUB_API=https://api.github.com

# Where the relay listens. Your tunnel or reverse proxy forwards RELAY_PATH here.
RELAY_HOST=127.0.0.1
RELAY_PORT=3110
RELAY_PATH=/hooks/github

# ---- Watchdog: wakes agents whose work Paperclip left stalled

WATCHDOG=true
WATCHDOG_INTERVAL_SEC=60
# How long an issue must be quiet before the watchdog acts.
WATCHDOG_STALL_SEC=180
# Nudge comments per stalled situation, and "send queued messages now" retries
# per deferred wake (WATCHDOG_RETRY_DEFERRED).
WATCHDOG_MAX_NUDGES=2
# A done blocker whose workspace clean-up (workspace_finalize) failed keeps its
# dependent blocked forever. true = remove it from "Blocked by" after the stall
# window, move the dependent to todo if nothing else blocks it, and explain why
# in a comment.
WATCHDOG_HEAL_FAILED_FINALIZE=true
# A wake deferred behind a stopped run that still holds execution waits forever.
# true = press Paperclip's "send queued messages now" for it, which retries the
# run's lease clean-up once and re-sends the saved comments. Never interrupts a
# running run.
WATCHDOG_RETRY_DEFERRED=true

# ---- Cost sync: what subscription runs would have cost on the API
#
# Posts each finished subscription run's API-equivalent cost to Paperclip's
# Costs page. The amounts count toward budgets and can't be deleted, so it's off
# in this file: preview with `pch costs`, then set COST_SYNC=true. (The installer
# shows the preview and asks.)

COST_SYNC=false
COST_SYNC_INTERVAL_SEC=900
# Only runs that finished after this time (ISO 8601). Empty = every run the helper
# can see (the latest 1,000 per company).
COST_SYNC_SINCE=
# Agent adapters whose subscription runs are synced.
COST_SYNC_ADAPTERS=claude_local,codex_local
# The model to price Codex runs with when Paperclip didn't record one (the agent
# uses Codex's default model). Empty = leave those runs unsynced.
CODEX_DEFAULT_MODEL=
# Your own prices, in the data directory: see src/prices.mjs for the format.
#COST_PRICES_FILE=/data/prices.json
# Seconds to wait after a run finishes before reading its usage.
#COST_SYNC_SETTLE_SEC=300

# ---- Advanced

# Seconds to wait for each Paperclip request.
#PAPERCLIP_TIMEOUT_SEC=20
# The name of the board API key `pch login` creates.
#PAPERCLIP_KEY_NAME=paperclip-helper
# Where the helper keeps its key and state. The container uses /data; change it
# only when running without Docker. PAPERCLIP_TOKEN_FILE, STATE_FILE, STATUS_FILE
# and COST_STATE_FILE default to files in it.
#DATA_DIR=/data
