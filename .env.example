# Paperclip Helper settings. For a manual install, copy this file to .env and
# chmod 600 it; the installer writes its own .env.
# Every setting is optional unless marked required. Docs:
# https://github.com/DevEnterpriseSoftware/paperclip-helper

# ---- Docker (read by compose.yml)

# The user and group that own ./data (`id -u`, `id -g`). Default 1000:1000.
PCH_UID=1000
PCH_GID=1000
# Another image or tag, e.g. a pinned version: ghcr.io/deventerprisesoftware/paperclip-helper:1.0.0
#PCH_IMAGE=

# ---- Paperclip

# Paperclip's API as seen from inside the helper container. With host
# networking that's the port Paperclip listens on or publishes on the host.
# Any hostname other than localhost/127.0.0.1 must be allowed in Paperclip:
# `npx paperclipai allowed-hostname <host>`.
PAPERCLIP_API=http://127.0.0.1:3100

# The address you open Paperclip at in a browser. Used only for the approval
# link `pch login` prints.
PAPERCLIP_PUBLIC_URL=

# Lifetime of the board API key `pch login` creates, in days (0 = never expires).
KEY_EXPIRES_DAYS=365

# true = every component logs what it would do and changes nothing.
DRY_RUN=false

# debug, info, warn or error.
LOG_LEVEL=info

# ---- Relay: GitHub webhooks → your approval decisions
#
# Turns on by itself when any of the three GitHub settings below is set, and then
# needs all three. RELAY=false keeps it off regardless; RELAY=true refuses to
# start without them.

#RELAY=

# Required for the relay. The shared secret you also give the GitHub webhook.
# Generate one with `openssl rand -hex 32` (or `pch secret`).
GITHUB_WEBHOOK_SECRET=

# Required for the relay. Your GitHub login: only your merges, reviews and
# comments approve or request changes.
GITHUB_OWNER_LOGIN=

# Required for the relay. Comma-separated owner/repo list the relay accepts.
GITHUB_REPOS=

# Issue prefixes to look for in a PR's title, branch or body, comma-separated.
# Empty = every prefix of the companies your key can see (read from Paperclip).
ISSUE_PREFIXES=

# Post each newly opened (or reopened, or ready-for-review) PR's URL on its issue,
# so Paperclip links it: its "GitHub Pull Request" rows only pick up full
# github.com URLs in the issue's text.
RELAY_LINK_PRS=true
# Notes that need nothing from the agent (PR opened, closed unmerged, merged by
# someone else) go in the issue's "pull-requests" document, which wakes nobody.
# false = comments, which wake the issue's assignee for nothing.
RELAY_QUIET_NOTES=true

# Reply on the PR when your /changes, /approve or "Request changes" isn't recorded
# as a decision (the issue isn't waiting on you, several are, or the PR names no
# issue), saying where your text went and why. Needs GITHUB_TOKEN or GITHUB_TOKEN_FILE.
#RELAY_PR_NOTES=true

# Send PRs with merge conflicts back to their agents. After every merge (and
# every RELAY_CONFLICT_SWEEP_SEC) the relay looks at the other open PRs, and for
# each one GitHub says conflicts with its base branch it requests changes on the
# PR's issue (or comments, when its review isn't waiting on you) and says so on
# the PR. Needs GITHUB_TOKEN or GITHUB_TOKEN_FILE.
RELAY_FIX_CONFLICTS=false

# A GitHub token for the above, and for RELAY_PR_NOTES. Fine-grained: access to the GITHUB_REPOS
# repositories only, with "Pull requests: Read and write" (Read-only if
# RELAY_CONFLICT_PR_COMMENT=false). The watchdog's WATCHDOG_CI_RUNS uses it too and
# needs "Actions: Read" ("Read and write" to re-run flaky jobs). Classic: the "repo" scope. Steps:
# https://github.com/DevEnterpriseSoftware/paperclip-helper/blob/main/docs/relay.md#the-github-token
GITHUB_TOKEN=

# Or, instead of GITHUB_TOKEN: a file holding the token, inside the container,
# read again for every GitHub request. For a token another program keeps fresh,
# such as a GitHub App installation token (it lasts an hour). Mount the file's
# folder read-only; the installer does it, and records the host path in
# GITHUB_TOKEN_HOST_FILE. Steps:
# https://github.com/DevEnterpriseSoftware/paperclip-helper/blob/main/docs/relay.md#a-token-file-github-app
#GITHUB_TOKEN_FILE=/run/github-token/token

# Send-backs per PR while it keeps conflicting, one per push, before it is left to you.
#RELAY_CONFLICT_MAX_ATTEMPTS=2
# Say on the PR that it was sent back.
#RELAY_CONFLICT_PR_COMMENT=true
# Also look at every open PR this often, in seconds. 0 = only after a merge.
#RELAY_CONFLICT_SWEEP_SEC=900

# A PR the merge queue drops without a conflict (needs the token above with
# "Actions: Read", and "Checks: Read" for the failure annotation): a failed
# merge-group check sends it back to its agent like a conflict; a cancelled run
# or the queue's status-check timeout is told to the board, since the PR isn't at
# fault. On by default; without a GitHub token it is off (the log says so once).
RELAY_MERGE_QUEUE=true
# Queue such a PR again yourself, once per head commit, only one a person queued.
# Needs a token allowed to merge (GraphQL enqueuePullRequest).
RELAY_REQUEUE_ON_INFRA_DROP=false
# When you merge an issue's own PR and the issue's review stages were wiped, close
# it as done, as the approval would have, so its dependants can start.
RELAY_DONE_WITHOUT_STAGES=true
# Your merge doesn't finish an issue whose hand-off comment (the one that sent it to
# review) or description contains this phrase, in any case: the relay records changes
# requested instead of approve, so the issue goes back to its implementer for the
# rest of the work. Your agents' instructions must quote the same phrase (see the
# README, "Keeping an issue open after a merge"). Empty: the check is off.
RELAY_MERGE_KEEP_OPEN_MARKER=Merge does not complete this issue
# Nor does it finish an issue with open child issues (not done or cancelled).
RELAY_MERGE_KEEP_OPEN_CHILDREN=false

# GitHub Enterprise Server: https://<host>/api/v3
#GITHUB_API=https://api.github.com

# Where the relay listens. Your tunnel or reverse proxy forwards RELAY_PATH here.
RELAY_HOST=127.0.0.1
RELAY_PORT=3110
RELAY_PATH=/hooks/github

# ---- Watchdog: wakes agents whose work Paperclip left stalled

WATCHDOG=true
WATCHDOG_INTERVAL_SEC=60
# How long an issue must be quiet before the watchdog acts.
WATCHDOG_STALL_SEC=180
# Nudge comments per stalled situation, and "send queued messages now" retries
# per deferred wake (WATCHDOG_RETRY_DEFERRED).
WATCHDOG_MAX_NUDGES=2
# A done blocker whose workspace clean-up (workspace_finalize) failed keeps its
# dependent blocked forever. true = remove it from "Blocked by" after the stall
# window, move the dependent to todo if nothing else blocks it, and explain why
# in a comment.
WATCHDOG_HEAL_FAILED_FINALIZE=true
# A wake deferred behind a stopped run that still holds execution waits forever.
# true = press Paperclip's "send queued messages now" for it, which retries the
# run's lease clean-up once and re-sends the saved comments. Never interrupts a
# running run.
WATCHDOG_RETRY_DEFERRED=true
# A run that stopped without a process id or stop record Paperclip can check (cut
# off at a hand-off, or an adapter that failed to start) leaves its issue held
# for good: every message is saved with "no verified stop record". true = once
# the run has been over for the stall window, record the board's reconciliation
# (the run stopped; what it did is unverified) and deliver the saved messages,
# as `pch release ISSUE --apply` does. Once per held run.
WATCHDOG_RELEASE_HOLDS=true
# An issue created from another issue's work is linked to that issue's workspace.
# Once that workspace is closed, every run on the issue fails at setup. true =
# clear the link on open issues linked to a closed workspace (the next run gets a
# new isolated one, as `pch workspace ISSUE --apply` does), and restart an agent
# whose last run failed on it. Never touches a link to a live workspace. Also wakes
# an agent that scheduled a workspace of its own for its next run.
WATCHDOG_CLEAR_DEAD_LINKS=true
# Paperclip never delivers a question card an agent addresses to a teammate who
# isn't the issue's assignee: it cancels the teammate's wake before it starts,
# and the card waits for good. true = once such a card has waited for the stall
# window, create an issue assigned to the teammate that says which card to answer
# and how, and close it once the card is answered or withdrawn. Once per card.
# false = leave it to you: `pch blocked` lists these cards either way.
WATCHDOG_ROUTE_QUESTIONS=true
# An agent that waits on a CI run (it names the run in its latest comment or its
# monitor's notes) is told once the run has finished, if it hasn't run since:
# Paperclip's monitors give up, and nothing else wakes it. Needs GITHUB_TOKEN or
# GITHUB_TOKEN_FILE with "Actions: Read" on GITHUB_REPOS; without one it is off.
# A monitor whose notes name that run is cleared when it is reported; one still
# due that names something else keeps the report back, so rely on the Helper or
# space monitors widely (30 minutes or more), not both at short intervals.
WATCHDOG_CI_RUNS=true
# Jobs you know to be flaky, as a regular expression on the job name, e.g.
# ^e2e \(windows\)$|^ci-gate$ . A finished run whose failed jobs all match is
# re-run ("Re-run failed jobs") before it is reported, up to WATCHDOG_CI_RERUN_MAX
# times, while it is still its PR's head. Needs "Actions: Read and write".
# Empty: never re-run.
WATCHDOG_CI_RERUN_JOBS=
WATCHDOG_CI_RERUN_MAX=2
# You answered an agent's card while its issue waited on your review: Paperclip
# woke you with the answer, not the agent. true = return the issue to that agent
# (your "changes requested") with the answer quoted, 30 minutes after you answered
# if you haven't decided yourself. Once per card.
WATCHDOG_DELIVER_ANSWERS=true
# After maxReviewRounds (3) agent change requests in a row, Paperclip hands the
# review to you instead of back to the implementer. That is deliberate, so false
# by default. true = return it to the implementer with the reviewer's latest
# request, WATCHDOG_MAX_NUDGES times per issue; each return (your decision) gives
# the agents maxReviewRounds more rounds. (Or raise maxReviewRounds in your
# execution policies.)
WATCHDOG_RETURN_ESCALATED_REVIEWS=false
# Paperclip never counts a cancelled blocker as resolved. true = tell the
# dependent's agent once, with why the blocker was cancelled, so it can remove or
# replace it.
WATCHDOG_CANCELLED_BLOCKERS=true
# Pausing an agent with runs queued or in flight makes Paperclip's recovery block
# each affected issue ("the original assignee is not invokable"), and resuming the
# agent restarts none of them. true = when a paused agent is resumed, restore each
# issue blocked during the pause that nobody has touched since (back to its status
# before the block, in review if a review stage is pending) and wake it. Issues
# blocked for any other reason are never touched.
WATCHDOG_RESUME_SWEEP=true
# Runs the watchdog may start for an agent at once, counting its runs already queued
# or going (the sweep's restores and the parked-issue nudges share it), so a resume
# doesn't queue dozens of runs. 0 = the agent's maxConcurrentRuns (1 if Paperclip
# doesn't show one).
WATCHDOG_RESUME_SWEEP_LIMIT=0
# Minutes after a resume before the agent's blocked issues are touched: a resume to
# check one thing, followed by a pause, restores and wakes nothing. 0 = at once.
WATCHDOG_RESUME_SETTLE_MIN=10
# A Claude account at its 5-hour, weekly or spend limit fails every agent's next run,
# and Paperclip keeps retrying them. true = pause the Claude agents on that account
# (the same ANTHROPIC_API_KEY secret, else the same CLAUDE_CODE_OAUTH_TOKEN secret,
# whatever each agent's CLAUDE_CONFIG_DIR; with neither, the login stored on the
# machine), each once it has no run going, and resume exactly those this many minutes
# after the reset. Agents you pause yourself stay paused; Codex agents are never paused.
WATCHDOG_LIMIT_PAUSE=true
WATCHDOG_LIMIT_RESUME_GRACE_MIN=5
# An issue to comment on when a limit pauses agents (e.g. ACM-12). Pick one assigned
# to a person or to nobody: a board comment wakes the assignee. Empty: log only.
WATCHDOG_NOTIFY_ISSUE=
# An agent's update can wipe an issue's review stages (a Paperclip bug), and the
# issue closes with its PR still open and unreviewed. true = reopen a done issue
# whose own PR is still open (needs a GitHub token), and tell the board about
# issues in progress or in review whose stages were removed. Stages aren't
# re-created: that's the board's call.
WATCHDOG_STAGES_WIPE=true

# ---- Cost sync: what subscription runs would have cost on the API
#
# Posts each finished subscription run's API-equivalent cost to Paperclip's
# Costs page. The amounts count toward budgets and can't be deleted, so it's off
# in this file: preview with `pch costs`, then set COST_SYNC=true. (The installer
# shows the preview and asks.)

COST_SYNC=false
COST_SYNC_INTERVAL_SEC=900
# Only runs that finished after this time (ISO 8601). Empty = every run the helper
# can see (the latest 1,000 per company).
COST_SYNC_SINCE=
# Agent adapters whose subscription runs are synced.
COST_SYNC_ADAPTERS=claude_local,codex_local
# The model to price Codex runs with when Paperclip didn't record one (the agent
# uses Codex's default model). Empty = leave those runs unsynced.
CODEX_DEFAULT_MODEL=
# Your own prices, in the data directory: see src/prices.mjs for the format.
#COST_PRICES_FILE=/data/prices.json
# Seconds to wait after a run finishes before reading its usage.
#COST_SYNC_SETTLE_SEC=300

# ---- Advanced

# Seconds to wait for each Paperclip request.
#PAPERCLIP_TIMEOUT_SEC=20
# The name of the board API key `pch login` creates.
#PAPERCLIP_KEY_NAME=paperclip-helper
# Where the helper keeps its key and state. The container uses /data; change it
# only when running without Docker. PAPERCLIP_TOKEN_FILE, STATE_FILE, STATUS_FILE
# and COST_STATE_FILE default to files in it.
#DATA_DIR=/data
